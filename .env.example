# PIN de acesso ao app (use 6+ dígitos)
APP_PIN=
# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional: modelo (padrão gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# JSON da conta de serviço do Firebase em UMA linha (é o que vai no Vercel)
FIREBASE_CREDENTIALS=
# Só local: em vez de FIREBASE_CREDENTIALS, aponte para o arquivo
# FIREBASE_CREDENTIALS_FILE=firebase_credentials.json
